# PostgreSQL (Port 5434 dipetakan di host agar tidak bentrok dengan instance postgres lokal lain)
POSTGRES_USER=bangungrid
POSTGRES_PASSWORD=bangungrid_secret_pass
POSTGRES_DB=bangungrid_main
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Redis (Port 6380 dipetakan di host)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_secret_pass

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_CLIENT_PORT=4222
NATS_MGMT_PORT=8222

# MinIO S3 Object Storage
MINIO_ROOT_USER=bangungrid_minio
MINIO_ROOT_PASSWORD=minio_secret_pass
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Auth Service
AUTH_PORT=8085
AUTH_HTTP_PORT=8085
AUTH_JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
AUTH_JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
AUTH_JWT_EXPIRATION_HOURS=24
AUTH_REFRESH_TOKEN_EXPIRATION_DAYS=7
