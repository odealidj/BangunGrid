      "input_query_strings": ["*"],
      "input_headers": ["*"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 50,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/catalog/products",
          "encoding": "no-op",
          "method": "GET",
          "host": ["http://catalog-service:8082"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/catalog/products",
