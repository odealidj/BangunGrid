{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "BangunGrid Enterprise API Gateway",
  "port": 8080,
  "cache_ttl": "300s",
  "timeout": "10000ms",
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type",
        "Accept",
        "X-Requested-With",
        "X-Tenant-ID",
        "X-Branch-ID",
        "X-Idempotency-Key",
        "X-Request-ID"
      ],
      "expose_headers": ["Content-Length"],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/healthz",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/healthz",
          "encoding": "no-op",
          "method": "GET",
          "host": ["http://auth-service:8081"]
        }
      ]
    },
    {
      "endpoint": "/.well-known/jwks.json",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/.well-known/jwks.json",
          "encoding": "no-op",
          "method": "GET",
          "host": ["http://auth-service:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/register",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/api/v1/auth/register",
          "encoding": "no-op",
          "method": "POST",
          "host": ["http://auth-service:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 20,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "encoding": "no-op",
          "method": "POST",
          "host": ["http://auth-service:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/refresh",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/api/v1/auth/refresh",
          "encoding": "no-op",
          "method": "POST",
          "host": ["http://auth-service:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/profile",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth-service:8081/.well-known/jwks.json",
          "disable_jwk_security": true,
          "operation_debug": true,
          "propagate_claims": [
            ["sub", "x-user-id"],
            ["role", "x-user-role"],
            ["tenant_id", "x-tenant-id"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/auth/profile",
          "encoding": "no-op",
          "method": "GET",
          "host": ["http://auth-service:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/catalog/categories",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": ["*"],
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/api/v1/catalog/categories",
          "encoding": "no-op",
          "method": "GET",
          "host": ["http://catalog-service:8082"]
        }
      ]
    },
