      "backend": [
        {
          "url_pattern": "/api/v1/catalog/bulk/calculate",
          "encoding": "no-op",
          "method": "POST",
          "host": ["http://catalog-service:8082"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/catalog/bulk/verify-weighbridge",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/api/v1/catalog/bulk/verify-weighbridge",
          "encoding": "no-op",
